# Copy to .env (never commit .env). Names are what the code reads (app/config/settings.py).
OPENROUTER_API_KEY=
TINKER_API_KEY=
# Live web search for the agent's own `search` tool (TDD §5.2). One of: tavily | exa | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TTS_API_KEY=
STT_API_KEY=
SUPABASE_URL=
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://app_rw:app_rw@localhost:5432/briefing
DATABASE_ADMIN_URL=postgresql://app_admin:app_admin@localhost:5432/briefing
APP_MODE=live

# ---- added by W-E (platform) -------------------------------------------------------------------------
# dev | test | prod. DEV_AUTH_BYPASS is ignored when APP_ENV=prod.
APP_ENV=dev
DEV_AUTH_BYPASS=0
# Owner role used only to apply supabase/migrations (python -m app.db.migrate). Not used by the app.
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefing
# Public https URL of the web service (used for ws_url); derived from the request if empty.
PUBLIC_BASE_URL=
# Supabase: legacy HS256 projects only; server-only service key for Storage + auth-user deletion.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Speech: TTS_PROVIDER=openai (any OpenAI-compatible /audio/speech) | fake; STT_PROVIDER=groq | openai | fake
TTS_PROVIDER=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
STT_PROVIDER=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# Brief audio: local (dev, served at /media) | supabase (bucket brief-audio)
AUDIO_STORAGE=local
AUDIO_LOCAL_DIR=var/audio
AUDIO_BUCKET=brief-audio
# Replay archive for replay-mode tools
ARCHIVE_PATH=eval/data/archive.sqlite
# Jobs: auto = real agents if importable, else the StubAgents placeholder; stub | real to force.
AGENT_PORTS=auto
WORKER_CONCURRENCY=4
# Voice model: auto = W-B model layer; fake = rule-based CorpusEchoModel (local dev only)
VOICE_MODEL=auto
# Spend guard credit pools (USD)
CREDIT_OPENROUTER_USD=200
CREDIT_TINKER_USD=100
RATE_LIMIT_PER_MIN=60
# ---- added by integration ------------------------------------------------------------------------------
# Hard per-process spend fence for the model Router (USD; empty = none) and the JSONL ledger path.
LLM_SPEND_CAP_USD=
LLM_LEDGER_PATH=eval/runs/llm_ledger.jsonl
# Optional: write newsroom / chief-of-staff run traces as JSON here.
TRACE_DIR=
