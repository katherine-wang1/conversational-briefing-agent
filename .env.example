# Copy to .env (never commit .env). Names are what the code reads.
OPENROUTER_API_KEY=
TINKER_API_KEY=
# Live web search for the agent's own `search` tool (TDD §5.2). One of: tavily | exa | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TTS_API_KEY=
STT_API_KEY=
SUPABASE_URL=
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefing
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/briefing
APP_MODE=live
