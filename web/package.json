{
  "name": "briefing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vad-assets.mjs",
    "dev": "node scripts/copy-vad-assets.mjs && vite",
    "dev:mock": "node scripts/copy-vad-assets.mjs && concurrently -k -n mock,web \"npm:mock\" \"vite\"",
    "mock": "node mock/server.mjs",
    "build": "node scripts/copy-vad-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "node scripts/copy-vad-assets.mjs && node e2e/smoke.mjs",
    "e2e:prod": "node scripts/copy-vad-assets.mjs && tsc -b && VITE_DEV_BYPASS=true vite build && E2E_PREVIEW=1 node e2e/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
