# Copy to web/.env.local (never commit it). All optional.

# Backend the Vite dev/preview server proxies /api, /ws and /audio to.
# Default: the mock server (npm run mock) on http://localhost:8787. Real backend (W-E): e.g. http://localhost:8000
BACKEND_URL=http://localhost:8787

# Call the API directly instead of through the dev proxy (e.g. a deployed backend). Empty = same origin.
VITE_API_BASE=

# Supabase auth (magic link + Google). Without these only the dev bypass is offered.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev bypass login: on in `vite dev`, off in builds unless "true". Token sent as the bearer.
VITE_DEV_BYPASS=
VITE_DEV_TOKEN=dev
